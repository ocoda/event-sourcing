{
	"$schema": "https://turborepo.dev/schema.json",
	"extends": ["//"],
	"tasks": {
		"dev": {
			"dependsOn": ["^build"]
		},
		"typecheck": {
			"description": "The example also compiles against the mongodb integration's sources.",
			"inputs": ["$TURBO_EXTENDS$", "$TURBO_ROOT$/packages/integration/mongodb/lib/**"]
		}
	}
}
