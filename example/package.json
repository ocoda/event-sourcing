{
	"name": "@ocoda/event-sourcing-example",
	"private": true,
	"license": "MIT",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json",
		"start": "node --enable-source-maps dist/main.js",
		"dev": "tsc -p tsconfig.build.json && node --enable-source-maps dist/main.js",
		"ci": "oxlint --deny-warnings && oxfmt --check",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"lint": "oxlint",
		"typecheck": "tsc --noEmit -p tsconfig.json"
	},
	"engines": {
		"node": ">=22.12"
	},
	"dependencies": {
		"@nestjs/common": "^12.1.1",
		"@nestjs/core": "^12.1.1",
		"@nestjs/platform-express": "^12.1.1",
		"@ocoda/event-sourcing": "workspace:*",
		"@ocoda/event-sourcing-mongodb": "workspace:*",
		"mongodb": "^7.7.0",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2"
	},
	"devDependencies": {
		"@ocoda/event-sourcing-config": "workspace:*",
		"@types/node": "22.20.4",
		"typescript": "7.0.2"
	}
}
