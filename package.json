{
	"name": "event-sourcing-monorepo",
	"description": "Monorepo for the @ocoda/event-sourcing packages",
	"author": "Dries Hooghe <dries@drieshooghe.com>",
	"license": "MIT",
	"private": true,
	"scripts": {
		"dev": "turbo dev",
		"build": "turbo build",
		"docs:build": "turbo docs:build",
		"test": "turbo test",
		"test:cov": "turbo test:cov",
		"test:consumers": "turbo build --filter=\"./packages/**\" --output-logs=errors-only && node scripts/test-consumers.mjs",
		"test:cross-version": "node scripts/test-cross-version.mjs",
		"ci": "turbo ci",
		"lint": "oxlint",
		"typecheck": "turbo typecheck",
		"check:packages": "turbo build --filter=\"./packages/**\" --output-logs=errors-only && node scripts/check-packages.mjs",
		"format": "oxfmt",
		"format:check": "oxfmt --check"
	},
	"engines": {
		"node": ">=22.12"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "0.18.5",
		"@changesets/changelog-github": "1.0.1",
		"@changesets/cli": "3.0.3",
		"@nestjs/common": "catalog:",
		"@types/node": "catalog:",
		"@vitest/coverage-v8": "5.0.5",
		"oxfmt": "0.74.0",
		"oxlint": "1.89.0",
		"publint": "0.3.25",
		"reflect-metadata": "catalog:",
		"rxjs": "catalog:",
		"turbo": "2.11.9",
		"typescript": "catalog:",
		"vite": "8.3.4",
		"vitest": "catalog:"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/ocoda/event-sourcing"
	},
	"packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61"
}
