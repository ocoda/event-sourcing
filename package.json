{
	"name": "event-sourcing-monorepo",
	"description": "Monorepo for the @ocoda/event-sourcing packages",
	"author": "Dries Hooghe <dries@drieshooghe.com>",
	"license": "MIT",
	"private": true,
	"scripts": {
		"dev": "turbo dev",
		"build": "turbo build",
		"docs:build": "turbo docs:build",
		"test": "turbo test",
		"test:cov": "turbo test:cov",
		"test:consumers": "turbo build --filter=\"./packages/**\" --output-logs=errors-only && node scripts/test-consumers.mjs",
		"test:cross-version": "node scripts/test-cross-version.mjs",
		"ci": "turbo ci",
		"lint": "oxlint",
		"typecheck": "turbo typecheck",
		"check:packages": "turbo build --filter=\"./packages/**\" --output-logs=errors-only && node scripts/check-packages.mjs",
		"format": "oxfmt",
		"format:check": "oxfmt --check"
	},
	"engines": {
		"node": ">=22.12"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "0.18.5",
		"@changesets/changelog-github": "1.0.1",
		"@changesets/cli": "3.0.3",
		"@nestjs/common": "catalog:",
		"@types/node": "catalog:",
		"@vitest/coverage-v8": "5.0.3",
		"oxfmt": "0.71.0",
		"oxlint": "1.86.0",
		"publint": "0.3.24",
		"reflect-metadata": "catalog:",
		"rxjs": "catalog:",
		"turbo": "2.11.5",
		"typescript": "catalog:",
		"vite": "8.3.1",
		"vitest": "catalog:"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/ocoda/event-sourcing"
	},
	"packageManager": "pnpm@12.8.1+sha512.f64ba907507f5ceafe06c8d38e6052d0179444580ec1279ddd5bfc11cb48aa8a2644b66598e07e761da84872a9fc57d5f902b87fa49d024198d558612aabbe45"
}
