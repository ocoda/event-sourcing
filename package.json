{
	"name": "event-sourcing-monorepo",
	"description": "Monorepo for the @ocoda/event-sourcing packages",
	"author": "Dries Hooghe <dries@drieshooghe.com>",
	"license": "MIT",
	"private": true,
	"scripts": {
		"dev": "turbo dev",
		"build": "turbo build",
		"docs:build": "turbo docs:build",
		"test": "turbo test",
		"test:cov": "turbo test:cov",
		"test:consumers": "turbo build --filter=\"./packages/**\" --output-logs=errors-only && node scripts/test-consumers.mjs",
		"test:cross-version": "node scripts/test-cross-version.mjs",
		"ci": "turbo ci",
		"lint": "oxlint",
		"typecheck": "turbo typecheck",
		"check:packages": "turbo build --filter=\"./packages/**\" --output-logs=errors-only && node scripts/check-packages.mjs",
		"format": "oxfmt",
		"format:check": "oxfmt --check"
	},
	"engines": {
		"node": ">=22.12"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "0.18.5",
		"@changesets/changelog-github": "1.0.1",
		"@changesets/cli": "3.0.3",
		"@nestjs/common": "catalog:",
		"@types/node": "catalog:",
		"@vitest/coverage-v8": "5.0.4",
		"oxfmt": "0.72.0",
		"oxlint": "1.87.0",
		"publint": "0.3.25",
		"reflect-metadata": "catalog:",
		"rxjs": "catalog:",
		"turbo": "2.11.7",
		"typescript": "catalog:",
		"vite": "8.3.4",
		"vitest": "catalog:"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/ocoda/event-sourcing"
	},
	"packageManager": "pnpm@12.13.0+sha512.1e55719bf26e809dce5c5084fdebaa64efb3da9038ae5d68a9f8a68311f1a45841c8c3b76a37298c3b66f6bcc80409a9b7f33c78a7168a3e90fb65a5d8235ae4"
}
