{
	"name": "event-sourcing-monorepo",
	"description": "Monorepo for the @ocoda/event-sourcing packages",
	"author": "Dries Hooghe <dries@drieshooghe.com>",
	"license": "MIT",
	"private": true,
	"scripts": {
		"dev": "turbo dev",
		"build": "turbo build",
		"docs:build": "turbo docs:build",
		"test": "turbo test",
		"test:cov": "turbo test:cov",
		"test:consumers": "turbo build --filter=\"./packages/**\" --output-logs=errors-only && node scripts/test-consumers.mjs",
		"test:cross-version": "node scripts/test-cross-version.mjs",
		"ci": "turbo ci",
		"lint": "oxlint",
		"typecheck": "turbo typecheck",
		"check:packages": "turbo build --filter=\"./packages/**\" --output-logs=errors-only && node scripts/check-packages.mjs",
		"format": "oxfmt",
		"format:check": "oxfmt --check"
	},
	"engines": {
		"node": ">=22.12"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "0.18.5",
		"@changesets/changelog-github": "1.0.1",
		"@changesets/cli": "3.0.3",
		"@nestjs/common": "catalog:",
		"@types/node": "catalog:",
		"@vitest/coverage-v8": "5.0.3",
		"oxfmt": "0.72.0",
		"oxlint": "1.87.0",
		"publint": "0.3.25",
		"reflect-metadata": "catalog:",
		"rxjs": "catalog:",
		"turbo": "2.11.7",
		"typescript": "catalog:",
		"vite": "8.3.3",
		"vitest": "catalog:"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/ocoda/event-sourcing"
	},
	"packageManager": "pnpm@12.10.0+sha512.122a7b6ddf9d40268bc0db1a9780899b95e4fa8badfca7bd450615ad8cf7c2659f5f569c20ed7c53886bc7b08d0d50a54f4ad50706847f5682ec6c5048416539"
}
