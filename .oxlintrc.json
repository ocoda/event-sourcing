{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript", "import", "unicorn", "promise", "node", "vitest", "oxc"],
	"categories": {
		"correctness": "error"
	},
	"env": {
		"builtin": true,
		"node": true,
		"es2024": true
	},
	// benchmarks/ is not maintained and has never been linted.
	"ignorePatterns": ["dist", "coverage", ".astro", ".turbo", "benchmarks"],
	"rules": {
		"no-unused-vars": [
			"error",
			{ "args": "none", "caughtErrors": "none", "ignoreRestSiblings": true, "varsIgnorePattern": "^_" }
		],
		"no-restricted-imports": [
			"error",
			{
				"patterns": [
					{
						"group": ["@nestjs/*/**"],
						"message": "Import from the package root (e.g. '@nestjs/common', '@nestjs/core'): deep imports reach into NestJS internals that are not part of the public API and do not resolve through the NestJS 12 exports map."
					}
				]
			}
		],
		"import/no-cycle": "warn",
		// Nest resolves constructor dependencies from design:paramtypes, which needs value imports.
		"typescript/consistent-type-imports": "off",
		"typescript/no-extraneous-class": ["error", { "allowWithDecorator": true, "allowStaticOnly": true }],
		// False positive on Nest's ExceptionFilter#catch(exception, host).
		"promise/valid-params": "off",
		"vitest/expect-expect": ["error", { "assertFunctionNames": ["expect", "expect*"] }],
		"vitest/no-conditional-expect": "off",
		"vitest/require-to-throw-message": "off",
		// Mocks take their types from the implementation or the property they replace; spelling out
		// vi.fn<...>() on every stub adds noise without catching anything the type checker misses.
		"vitest/require-mock-type-parameters": "off",
		"vitest/valid-title": ["error", { "ignoreTypeOfDescribeName": true }]
	},
	"overrides": [
		{
			// Known cycle (decorators -> providers -> integration -> helpers) through the core barrels, to be fixed
			// separately. Remove this override once that cycle is broken.
			"files": ["packages/core/lib/**"],
			"rules": {
				"import/no-cycle": "off"
			}
		},
		{
			"files": ["**/tests/**", "packages/testing/**", "fixtures/**"],
			"env": {
				"vitest": true
			},
			"rules": {
				// Empty classes are the usual fixture for commands, queries, events and handlers.
				"typescript/no-extraneous-class": [
					"error",
					{ "allowWithDecorator": true, "allowStaticOnly": true, "allowEmpty": true }
				]
			}
		}
	]
}
