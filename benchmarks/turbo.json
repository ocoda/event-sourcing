{
	"$schema": "https://turborepo.dev/schema.json",
	"extends": ["//"],
	"tasks": {
		"benchmark:build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/*"]
		},
		"benchmark": {
			"dependsOn": ["benchmark:build"],
			"cache": false
		},
		"benchmark:report": {
			"outputs": ["report/report.md"]
		}
	}
}
