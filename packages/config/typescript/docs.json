{
	"$schema": "https://json.schemastore.org/tsconfig",
	"display": "Ocoda Event Sourcing Docs",
	"extends": "./base.json",
	"compilerOptions": {
		"module": "esnext",
		"moduleResolution": "bundler",
		"lib": ["dom", "dom.iterable", "esnext"],
		"allowJs": true,
		"resolveJsonModule": true,
		"jsx": "preserve",
		"noEmit": true,
		"incremental": true,
		"declaration": false,
		"sourceMap": false
	}
}
