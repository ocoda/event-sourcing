{
	"name": "@ocoda/event-sourcing-mongodb",
	"version": "4.0.0-next.1",
	"description": "NestJS Event Sourcing Library (@mongodb)",
	"keywords": [
		"nestjs",
		"nest",
		"event-sourcing",
		"cqrs",
		"ddd",
		"domain-driven-design",
		"event-store",
		"aggregate",
		"mongodb",
		"mongo"
	],
	"homepage": "https://ocoda.github.io/event-sourcing",
	"bugs": {
		"url": "https://github.com/ocoda/event-sourcing/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ocoda/event-sourcing.git",
		"directory": "packages/integration/mongodb"
	},
	"funding": {
		"type": "github",
		"url": "https://github.com/sponsors/drieshooghe"
	},
	"license": "MIT",
	"author": "Dries Hooghe <dries@drieshooghe.com>",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"migrations"
	],
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json",
		"test": "vitest run",
		"test:cov": "vitest run --coverage",
		"ci": "oxlint --deny-warnings && oxfmt --check",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"gen:migration-sql": "UPDATE_MIGRATION_SQL=1 vitest run tests/unit/mongodb.migration-script.spec.ts",
		"lint": "oxlint",
		"typecheck": "tsc --noEmit -p tsconfig.json"
	},
	"engines": {
		"node": ">=22.12"
	},
	"peerDependencies": {
		"@nestjs/common": "^12.0.0",
		"@ocoda/event-sourcing": "workspace:^",
		"mongodb": "^6.10.0 || ^7.0.0"
	},
	"devDependencies": {
		"@nestjs/common": "catalog:",
		"@nestjs/core": "catalog:",
		"@nestjs/platform-express": "catalog:",
		"@nestjs/testing": "catalog:",
		"@ocoda/event-sourcing": "workspace:*",
		"@ocoda/event-sourcing-config": "workspace:*",
		"@ocoda/event-sourcing-testing": "workspace:*",
		"@types/node": "catalog:",
		"mongodb": "7.7.0",
		"reflect-metadata": "catalog:",
		"rxjs": "catalog:",
		"typescript": "catalog:"
	}
}
