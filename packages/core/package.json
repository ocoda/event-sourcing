{
	"name": "@ocoda/event-sourcing",
	"version": "3.0.0",
	"description": "NestJS Event Sourcing Library (@core)",
	"author": "Dries Hooghe <dries@drieshooghe.com>",
	"license": "MIT",
	"main": "./dist/index.js",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		}
	},
	"scripts": {
		"build": "rm -rf dist && tsup lib/index.ts --format cjs,esm --dts",
		"build:watch": "rm -rf dist && tsup lib/index.ts --format cjs,esm --dts --watch",
		"test": "vitest run",
		"test:cov": "vitest run --coverage",
		"test:cov:check": "vitest run --coverage",
		"ci": "biome ci",
		"format": "biome format --write",
		"lint": "biome check --write"
	},
	"bugs": {
		"url": "https://github.com/ocoda/event-sourcing/issues"
	},
	"engines": {
		"node": ">= 20.0.0"
	},
	"dependencies": {
		"class-transformer": "0.5.1",
		"ulidx": "^2.4.1"
	},
	"peerDependencies": {
		"@nestjs/common": "^11.0.0",
		"@nestjs/core": "^11.0.0",
		"reflect-metadata": "^0.2.0",
		"rxjs": "^7.2.0"
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@faker-js/faker": "^10.2.0",
		"@nestjs/common": "11.1.6",
		"@nestjs/core": "11.1.6",
		"@nestjs/platform-express": "11.1.6",
		"@nestjs/testing": "11.1.6",
		"@ocoda/event-sourcing-config": "workspace:*",
		"@ocoda/event-sourcing-testing": "workspace:*",
		"@swc-node/register": "^1.11.1",
		"@swc/core": "1.13.5",
		"@types/node": "20.17.6",
		"@vitest/coverage-v8": "^4.0.0",
		"reflect-metadata": "0.2.2",
		"rxjs": "7.8.2",
		"tsup": "^8.5.0",
		"typescript": "5.9.2",
		"unplugin-swc": "^1.5.7",
		"vitest": "^4.0.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/ocoda/event-sourcing",
		"directory": "packages/core"
	}
}
