{
	"name": "@ocoda/event-sourcing",
	"version": "4.0.0-next.1",
	"description": "NestJS Event Sourcing Library (@core)",
	"keywords": [
		"nestjs",
		"nest",
		"event-sourcing",
		"cqrs",
		"ddd",
		"domain-driven-design",
		"event-store",
		"aggregate"
	],
	"homepage": "https://ocoda.github.io/event-sourcing",
	"bugs": {
		"url": "https://github.com/ocoda/event-sourcing/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ocoda/event-sourcing.git",
		"directory": "packages/core"
	},
	"funding": {
		"type": "github",
		"url": "https://github.com/sponsors/drieshooghe"
	},
	"license": "MIT",
	"author": "Dries Hooghe <dries@drieshooghe.com>",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./testing": {
			"types": "./dist/testing/index.d.ts",
			"import": "./dist/testing/index.js",
			"require": "./dist/testing/index.js",
			"default": "./dist/testing/index.js"
		},
		"./package.json": "./package.json"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json",
		"build:watch": "rm -rf dist && tsc -p tsconfig.build.json --watch",
		"test": "vitest run",
		"test:cov": "vitest run --coverage",
		"ci": "oxlint --deny-warnings && oxfmt --check",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"lint": "oxlint",
		"typecheck": "tsc --noEmit -p tsconfig.json"
	},
	"engines": {
		"node": ">=22.12"
	},
	"dependencies": {
		"class-transformer": "0.5.1",
		"ulidx": "^2.4.1"
	},
	"peerDependencies": {
		"@nestjs/common": "^12.0.0",
		"@nestjs/core": "^12.0.0",
		"reflect-metadata": "^0.2.0",
		"rxjs": "^7.8.0",
		"vitest": "^5.0.0"
	},
	"peerDependenciesMeta": {
		"vitest": {
			"optional": true
		}
	},
	"devDependencies": {
		"@nestjs/common": "catalog:",
		"@nestjs/core": "catalog:",
		"@nestjs/platform-express": "catalog:",
		"@nestjs/testing": "catalog:",
		"@ocoda/event-sourcing-config": "workspace:*",
		"@ocoda/event-sourcing-testing": "workspace:*",
		"@types/node": "catalog:",
		"reflect-metadata": "catalog:",
		"rxjs": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
