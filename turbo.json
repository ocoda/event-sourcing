{
	"$schema": "https://turborepo.dev/schema.json",
	"agentGuidance": false,
	"tasks": {
		"build": {
			"description": "Compile lib/ (src/ for the example) into per-file ESM in dist/ with tsc -p tsconfig.build.json.",
			"dependsOn": ["^build"],
			"inputs": ["lib/**", "src/**", "tsconfig*.json", "package.json", "$TURBO_ROOT$/packages/config/typescript/**"],
			"outputs": ["dist/**"]
		},
		"typecheck": {
			"description": "tsc --noEmit over lib/ and tests/. tsconfig paths resolve core and the shared suite from source.",
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/packages/config/typescript/**",
				"$TURBO_ROOT$/packages/core/lib/**",
				"$TURBO_ROOT$/packages/testing/**/*.ts",
				"!$TURBO_ROOT$/packages/testing/node_modules/**"
			],
			"outputs": []
		},
		"lint": {
			"description": "oxlint, read-only.",
			"inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.oxlintrc.json"],
			"outputs": []
		},
		"format:check": {
			"description": "oxfmt --check, read-only.",
			"inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.oxfmtrc.json"],
			"outputs": []
		},
		"ci": {
			"description": "oxlint --deny-warnings and oxfmt --check, read-only.",
			"inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.oxlintrc.json", "$TURBO_ROOT$/.oxfmtrc.json"],
			"outputs": []
		},
		"format": {
			"description": "oxfmt, rewrites files in place.",
			"cache": false
		},
		"test": {
			"description": "vitest run. Specs alias core and the shared suite to their sources. DB-backed packages disable caching in their own turbo.json. ES_TEST_* set the test databases (packages/testing/unit/db.ts).",
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/packages/config/typescript/**",
				"$TURBO_ROOT$/packages/config/vitest/**",
				"$TURBO_ROOT$/packages/core/lib/**",
				"$TURBO_ROOT$/packages/testing/**/*.ts",
				"!$TURBO_ROOT$/packages/testing/node_modules/**"
			],
			"env": [
				"CONFORMANCE_RUN_SKIPPED",
				"ES_TEST_PG_HOST",
				"ES_TEST_PG_PORT",
				"ES_TEST_PG_USER",
				"ES_TEST_PG_PASSWORD",
				"ES_TEST_PG_DATABASE",
				"ES_TEST_MARIADB_HOST",
				"ES_TEST_MARIADB_PORT",
				"ES_TEST_MARIADB_USER",
				"ES_TEST_MARIADB_PASSWORD",
				"ES_TEST_MARIADB_DATABASE",
				"ES_TEST_MARIADB_ROOT_PASSWORD",
				"ES_TEST_MONGODB_URL",
				"ES_TEST_MONGODB_RS_URL"
			],
			"outputs": []
		},
		"test:cov": {
			"description": "vitest run --coverage, enforcing the coverage thresholds.",
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/packages/config/typescript/**",
				"$TURBO_ROOT$/packages/config/vitest/**",
				"$TURBO_ROOT$/packages/core/lib/**",
				"$TURBO_ROOT$/packages/testing/**/*.ts",
				"!$TURBO_ROOT$/packages/testing/node_modules/**"
			],
			"env": [
				"CONFORMANCE_RUN_SKIPPED",
				"ES_TEST_PG_HOST",
				"ES_TEST_PG_PORT",
				"ES_TEST_PG_USER",
				"ES_TEST_PG_PASSWORD",
				"ES_TEST_PG_DATABASE",
				"ES_TEST_MARIADB_HOST",
				"ES_TEST_MARIADB_PORT",
				"ES_TEST_MARIADB_USER",
				"ES_TEST_MARIADB_PASSWORD",
				"ES_TEST_MARIADB_DATABASE",
				"ES_TEST_MARIADB_ROOT_PASSWORD",
				"ES_TEST_MONGODB_URL",
				"ES_TEST_MONGODB_RS_URL"
			],
			"outputs": ["coverage/**"]
		},
		"dev": {
			"description": "Long-running watch process.",
			"cache": false,
			"persistent": true
		},
		"docs:build": {
			"description": "Static Astro (Starlight) build into dist/, including the sitemap, llms.txt and the Pagefind index. Fails on broken internal links.",
			"outputs": ["dist/**"]
		},
		"benchmark": {
			"cache": false
		},
		"benchmark:report": {}
	}
}
