{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"dev": {},
		"build": {
			"dependsOn": ["^build"]
		},
		"test": {},
		"test:cov": {},
		"ci": {
			"inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.oxlintrc.json", "$TURBO_ROOT$/.oxfmtrc.json"]
		},
		"lint": {
			"inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.oxlintrc.json"]
		},
		"typecheck": {
			"cache": false
		},
		"format": {
			"cache": false
		},
		"benchmark": {},
		"benchmark:report": {}
	}
}
